{
  "name": "intellico-app",
  "version": "1.0.0",
  "description": "Intellico Dental Research Analysis Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m app.main",
    "dev:frontend": "cd frontend/intellico && npm run dev",
    "build:frontend": "cd frontend/intellico && npm run build",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "install:all": "npm install && cd frontend/intellico && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@iflow-mcp/git-mcp": "^1.0.0"
  }
}
